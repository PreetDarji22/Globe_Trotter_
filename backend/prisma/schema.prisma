generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  passwordHash   String
  profilePicture String?
  createdAt      DateTime @default(now())
  trips          Trip[]
  likes          Like[]
  comments       Comment[]
}


model Trip {
  id          String     @id @default(uuid())
  userId      String
  user         User      @relation(fields: [userId], references: [id])
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverPhoto  String?
  isPublic    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  stops        TripStop[]
  likes        Like[]
  comments    Comment[]
}

model City {
  id              String     @id @default(uuid())
  name             String
  country          String
  costIndex        String     
  popularityScore Int
  imageUrl        String?
  tripStops       TripStop[]
}

model TripStop {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id])
  cityId     String
  city       City      @relation(fields: [cityId], references: [id])
  startDate  DateTime
  endDate    DateTime
  orderIndex Int
  activities Activity[]
}


model Activity {
  id              String   @id @default(uuid())
  tripStopId      String
  tripStop        TripStop @relation(fields: [tripStopId], references: [id])
  name            String
  category        String   
  startTime       DateTime
  durationMinutes Int
  estimatedCost   Decimal
  description     String?
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id])
  createdAt DateTime@default(now())

  @@unique([userId, tripId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id])
  createdAt DateTime@default(now())
}
